# MetOp-A/B/C GOME-2 Level 1B share the same geolocation layout.
dataset_formats[gome2_l1b] : dataset_format
  name = "GOME-2 Level 1B"
  identification
    file_glob = "*_gome.nc"
    platform = "MetOp M0?"
    sensor = "GOME-2"
    product_type = "GO2_L1B___"
  observation_group = "OBSERVATIONS"
  coordinate_group = "GEODATA"
  latitude = "latitude"
  longitude = "longitude"
  latitude_bounds = "latitude_bounds"
  longitude_bounds = "longitude_bounds"
  scan_direction
    group = "coordinate"
    variable = "scan_direction"
    forward_values = "1"
    backward_values = "2"
    default_filter = "forward"
