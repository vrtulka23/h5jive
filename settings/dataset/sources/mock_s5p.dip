# Repository root defaults to settings/; set the host path in overrides.dip.
dataset_sources[mock_s5p] : dataset_source
  name = "Sentinel-5P TROPOMI L1B mock"
  root = "./"
  format link = {?dataset_formats[s5p_tropomi_l1b_radiance]}
  tags = "mock, s5p, sentinel-5p, tropomi, radiance, l1b"
  product_regex = "^S5P_[^/]+_L1B_RA_BD[0-9]_(?P<year>[0-9]{4})(?P<month>[0-9]{2})(?P<day>[0-9]{2})T[0-9]{6}_[0-9]{8}T[0-9]{6}_(?P<orbit>[0-9]+)_[^/]*[.]nc$"
