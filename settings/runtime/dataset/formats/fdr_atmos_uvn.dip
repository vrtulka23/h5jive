dataset_formats[fdr_atmos_uvn] : dataset_format
  ?descr "FDR4ATMOS UVN Level 1A and 1B products share GOME and SCIAMACHY observation and geodata groups."
  name = "FDR4ATMOS UVN"

  identification
    file_glob = "ESA_FDR_ATMOS__L1?_UVN__*.nc"

    platform = "ERS-2, ENVISAT"

    sensor = "GOME, SCIAMACHY"

    product_type = "ATMOS__L1?"

  observation_group = "OBSERVATIONS"

  coordinate_group = "GEODATA"

  latitude = "latitude"

  longitude = "longitude"

  latitude_bounds = "latitude_bounds"

  longitude_bounds = "longitude_bounds"

  time_coordinate = ""

  overpass_group_depth = 1
