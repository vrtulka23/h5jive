dataset_formats[gome_l1b] : dataset_format
  ?descr "ERS-2 GOME L1B groups repeat this layout under each band."
  name = "GOME Level 1B"

  identification
    file_glob = "ER2_RPRO_GOM_L1B*.nc"

    platform = "ERS-2"

    sensor = "GOME"

    product_type = "GOM_L1B___"

  observation_group = "OBSERVATIONS"

  coordinate_group = "GEODATA"

  latitude = "latitude"

  longitude = "longitude"

  latitude_bounds = "latitude_bounds"

  longitude_bounds = "longitude_bounds"

  time_coordinate = "time"

  scan_direction
    forward_groups = "MODE_NADIR, MODE_NARROW_SWATH, MODE_NORTHPOLAR_VIEW, MODE_SOUTHPOLAR_VIEW, MODE_STATIC_VIEW"

    backward_groups = "MODE_NADIR_BACKSCAN, MODE_NARROW_SWATH_BACKSCAN, MODE_NORTHPOLAR_VIEW_BACKSCAN, MODE_SOUTHPOLAR_VIEW_BACKSCAN, MODE_STATIC_VIEW_BACKSCAN"

    default_filter = "both"
