# Repository root defaults to settings/; set the host path in overrides.dip.
dataset_sources[gome] : dataset_source
  name = "GOME L1B"
  root = "./"
  format link = {?dataset_formats[gome_l1b]}
  tags = "gome, ers2, uvn, l1b"
  product_regex = "^ER2_RPRO_GOM_L1B____(?P<year>[0-9]{4})(?P<month>[0-9]{2})(?P<day>[0-9]{2})T[0-9]{6}_[0-9]{8}T[0-9]{6}_(?P<orbit>[0-9]+)_[^/]*[.]nc$"
