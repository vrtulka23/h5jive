dataset_sources[pace_oci_l2] : dataset_source
  ?descr "Local PACE OCI Level-2 ocean-color granules with a calendar-date filename."
  name = "PACE OCI Level 2"

  root = "./"

  format link = {?dataset_formats[obpg_ocean_l2]}

  tags = "nasa, pace, oci, ocean-color, l2"

  product_regex = "^(?:.*/)?PACE_OCI[.](?P<year>[0-9]{4})(?P<month>[0-9]{2})(?P<day>[0-9]{2})T[0-9]{6}[.]L2[.][^/]+[.]nc$"
