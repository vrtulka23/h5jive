dataset_sources[s5p_tropomi_l2] : dataset_source
  ?descr "Example local Sentinel-5P TROPOMI Level-2 swath collection, including gas, aerosol, and cloud products that use PRODUCT coordinates."
  ?url "https://sentinels.copernicus.eu/documents/247904/3119978/Sentinel-5P-Level-2-Input-Output-Data-Definition.pdf/ecd7d731-72b3-4af1-8298-b9e3aa42c6d9?version=1.2"
  name = "Sentinel-5P TROPOMI Level 2"

  root = "./"

  format link = {?dataset_formats[s5p_tropomi]}

  tags = "sentinel-5p, tropomi, atmosphere, l2"

  product_regex = "^(?:.*/)?S5P_(?:NRTI|OFFL|RPRO)_L2__[A-Z0-9_]{6}_(?P<year>[0-9]{4})(?P<month>[0-9]{2})(?P<day>[0-9]{2})T[0-9]{6}_[0-9]{8}T[0-9]{6}_(?P<orbit>[0-9]+)_[^/]+[.]nc$"
