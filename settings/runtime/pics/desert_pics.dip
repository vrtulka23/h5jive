# Other desert PICS. A regional search window finds overpasses but does not define calibration pixels.
pics[libya_2] : calibration_site
  ?url "https://calval.cr.usgs.gov/apps/libya-2"
  name = "Libya 2"

  country = "Libya"

  category = "Desert PICS"

  center_latitude = 25.05

  center_longitude = 20.48

  roi_name = "Regional search window"

  roi_south = 24.55

  roi_north = 25.55

  roi_west = 19.98

  roi_east = 20.98

  status = "Active"

  notes = "Use product-specific cloud and aerosol screening before radiometric analysis."

