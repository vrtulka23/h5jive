?descr "Dataset format identification and geolocation discovery. Standard coordinate references are tried first."
name str

identification
  ?descr "Product identity from root metadata, with filename as a fallback."
  file_glob str
    ?descr "Fallback filename glob; * and ? wildcards are supported."

  platform str
    ?descr "Root platform attribute pattern."

  sensor str
    ?descr "Root sensor attribute pattern."

  product_type str
    ?descr "Root product_type attribute pattern."

observation_group str
  ?descr "Name of the group containing observation datasets."

coordinate_group str
  ?descr "Sibling group containing geolocation datasets."

latitude str

longitude str

latitude_bounds str

longitude_bounds str

time_coordinate str = ""
  ?descr "Optional name of a numeric CF time coordinate for the observation's first dimension. Empty uses automatic coordinate discovery."

overpass_group_depth int = 0
  ?descr "Leading geolocation path components identifying independent platforms within one product; 0 groups by product."
  !condition ({.} >= 0 && {.} <= 4)

layouts list
  ?descr "Optional alternative observation/geolocation layouts within one mission class. Each entry may narrow the filename glob."

scan_direction
  ?descr "Optional per-pixel scan flag or direction encoded by an ancestor group name. Unknown codes remain visible in Both mode."
  group str = "coordinate"
    ?descr "Flag location: coordinate, observation, or another sibling group path."

  forward_groups str = ""
    ?descr "Comma-separated ancestor group names whose observations are forward scans."

  backward_groups str = ""
    ?descr "Comma-separated ancestor group names whose observations are backward scans."

  variable str = ""

  forward_values str = ""
    ?descr "Comma-separated integer flag values for forward pixels."
    ?example "1, 3"
    !format "^$|^-?[0-9]+( *, *-?[0-9]+)*$"
    !condition ({.variable} == "" || {.} != "")

  backward_values str = ""
    ?descr "Comma-separated integer flag values for backward pixels."
    ?example "2, 4"
    !format "^$|^-?[0-9]+( *, *-?[0-9]+)*$"
    !condition ({.variable} == "" || {.} != "")

  default_filter str = "forward"
    ?descr "Initial map/globe pixel selection: forward, backward, or both."
    !options ["both", "forward", "backward"]
    !condition ({.} == "both" || {.} == "forward" || {.} == "backward")
