---
interface Props {
  root: string;
  home?: boolean;
  current?: 'features' | 'views' | 'plugins';
  pluginsCatalog?: boolean;
}

const { root, home = false, current, pluginsCatalog = false } = Astro.props;
const section = (id: string) => home ? `#${id}` : `${root}#${id}`;
const plugins = pluginsCatalog ? '#catalog' : `${root}plugins/`;
---

<nav aria-label="Main navigation">
  <a href={section('download')}>Install</a>
  <a href={section('browser')}>Browser</a>
  <a href={section('views')} aria-current={current === 'views' ? 'page' : undefined}>Views</a>
  <a href={plugins} aria-current={current === 'plugins' ? 'page' : undefined}>Plugins</a>
  <a href={section('capabilities')}>Capabilities</a>
  <a href={`${root}features/`} aria-current={current === 'features' ? 'page' : undefined}>Features</a>
  <a href={`${root}guide/`}>Guide</a>
  <a class="nav-cta" href="https://github.com/vrtulka23/h5jive">Source code <span aria-hidden="true">↗</span></a>
</nav>
