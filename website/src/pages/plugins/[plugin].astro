---
import { pluginPages } from '../../data/plugins';

export function getStaticPaths() {
  return pluginPages.map((plugin) => ({ params: { plugin: plugin.id }, props: { plugin } }));
}

const { plugin } = Astro.props;
const other = pluginPages.find((item) => item.id !== plugin.id);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#081b2d" />
    <meta name="description" content={`${plugin.name} in H5Jive Plugin Lab: ${plugin.summary}`} />
    <link rel="icon" type="image/png" href="../../h5jive-icon.png" />
    <link rel="stylesheet" href="../../site.css" />
    <link rel="stylesheet" href="../../layout.css" />
    <link rel="stylesheet" href="../../view-page.css" />
    <title>{plugin.name} — H5Jive Plugin Lab</title>
  </head>
  <body>
    <header class="topbar wrap">
      <a class="brand" href="../../" aria-label="H5Jive home"><img class="brand-icon" src="../../h5jive.png" width="42" height="42" alt="" /> H5Jive</a>
      <nav aria-label="Main navigation">
        <a href="../../#capabilities">Capabilities</a>
        <a href="../../#views">Views</a>
        <a href="../" aria-current="page">Plugins</a>
        <a href="../../guide/">Guide</a>
        <a class="nav-cta" href="https://github.com/vrtulka23/h5jive">Source code <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main>
      <div class="mode-page wrap">
        <nav class="mode-breadcrumb" aria-label="Breadcrumb"><a href="../../">Home</a><span aria-hidden="true">/</span><a href="../">Plugin Lab</a><span aria-hidden="true">/</span><span aria-current="page">{plugin.name}</span></nav>

        <section class="mode-hero" aria-labelledby="plugin-title">
          <div class="mode-heading"><p class="eyebrow">PLUGIN LAB / {plugin.name.toUpperCase()}</p><h1 id="plugin-title">{plugin.name}<span class="mode-title-dot">.</span></h1></div>
          <p class="mode-summary">{plugin.summary}</p>
        </section>

        <figure class="mode-preview"><img src={`../../${plugin.image}`} width="2564" height="1508" alt={plugin.alt} decoding="async" /><figcaption><span>H5JIVE <span class="caption-divider">/</span> PLUGIN LAB</span><span>{plugin.caption}</span></figcaption></figure>

        <section class="mode-content" aria-labelledby="plugin-features">
          <div class="mode-section-head"><p class="eyebrow">WHAT IT DOES</p><h2 id="plugin-features">Explore the comparison.</h2></div>
          <div class="mode-points">{plugin.points.map(([title, body], i) => <article class="mode-point"><span class="mode-number">0{i + 1}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
        </section>

        <section class="mode-workflow" aria-labelledby="plugin-workflow-title">
          <div><p class="eyebrow">TRY IT</p><h2 id="plugin-workflow-title">Start with the demo.</h2></div>
          <div><ol>{plugin.workflow.map((step) => <li>{step}</li>)}</ol><p class="mode-note">{plugin.note}</p></div>
        </section>

        <nav class="mode-neighbors" aria-label="Other plugins"><a href="../"><span>← PLUGIN LAB</span><strong>All plugins</strong></a><a href={`../${other.id}/`}><span>ANOTHER PLUGIN →</span><strong>{other.name}</strong></a></nav>
        <div class="mode-guide"><p>Want to try this plugin with example files?</p><a class="button primary" href={plugin.demo}>Open the demo <span>↗</span></a><a class="text-link" href={plugin.source}>Read the source <span>↗</span></a></div>
      </div>
    </main>
    <footer class="footer wrap"><a class="brand" href="../../"><img class="brand-icon" src="../../h5jive.png" width="32" height="32" alt="" /> H5Jive</a><span>Dig into your data.</span><span>© H5Jive contributors</span></footer>
  </body>
</html>
