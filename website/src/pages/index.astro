---
const features = [
  { n: '01', title: 'Inspect the structure', body: 'Move through groups, datasets, coordinate axes, attributes, and statistics without losing the context of the file.' },
  { n: '02', title: 'Read data in its shape', body: 'Switch between tables, profiles, 2D slices, and 3D voxel previews. Pin dimensions and choose the axes that matter.' },
  { n: '03', title: 'See where it happened', body: 'Map satellite observations with real pixel footprints when latitude and longitude bounds are available.' },
];
const views = ['Table', 'Profiles', '2D slice', '3D volume', 'World map'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#081b2d" />
    <meta name="description" content="H5Jive is a native scientific data explorer for HDF5 and NetCDF." />
    <link rel="icon" type="image/png" href="./h5jive-icon.png" />
    <link rel="stylesheet" href="./site.css" />
    <title>H5Jive — Dig into your data</title>
  </head>
  <body>
    <header class="topbar wrap">
      <a class="brand" href="#top" aria-label="H5Jive home"><img class="brand-icon" src="./h5jive.png" width="42" height="42" alt="" /> H5Jive</a>
      <nav aria-label="Main navigation">
        <a href="#capabilities">Capabilities</a>
        <a href="#data">Data</a>
        <a href="./guide/">Guide</a>
        <a class="nav-cta" href="https://github.com/vrtulka23/h5jive">Source code <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="top">
      <section class="hero wrap">
        <div class="hero-copy">
          <p class="eyebrow"><span class="pulse"></span> A scientific data explorer</p>
          <h1>Dig into your data.<br /><em>See the whole dataset.</em></h1>
          <p class="lede">H5Jive turns HDF5 and NetCDF files into something you can explore: their structure, values, dimensions, and place in the world.</p>
          <div class="hero-actions">
            <a class="button primary" href="./guide/">Read the project guide <span>→</span></a>
            <a class="text-link" href="#capabilities">Explore capabilities <span>↓</span></a>
          </div>
          <div class="hero-meta"><span>BUILT WITH RUST</span><i></i><span>HDF5 · NETCDF</span><i></i><span>NATIVE DESKTOP</span></div>
        </div>

        <div class="preview" aria-label="Illustration of a satellite data swath and dataset explorer">
          <div class="preview-head"><span><b class="dot"></b> GOME-2 BAND 3</span><span>WORLD MAP <b class="live">●</b></span></div>
          <div class="map-art">
            <svg viewBox="0 0 740 390" role="img" aria-label="Satellite scan pixels displayed over a world map">
              <defs>
                <pattern id="grid" width="46" height="39" patternUnits="userSpaceOnUse"><path d="M46 0H0V39" fill="none" stroke="#91bdce" stroke-opacity=".14" stroke-width="1"/></pattern>
                <linearGradient id="swath" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#12b8d1" stop-opacity=".35"/><stop offset="1" stop-color="#087da1" stop-opacity=".08"/></linearGradient>
              </defs>
              <rect width="740" height="390" fill="#0d2a40"/><rect width="740" height="390" fill="url(#grid)"/>
              <g fill="#173c55" stroke="#446a80" stroke-width="1.4">
                <path d="m82 92 30-27 65-8 30 21 46 10 10 24-27 21-12 40-35 12-21 40-26-6-10-34-31-19-14-36-24-11z"/>
                <path d="m212 224 27 12 22 38-7 56-23 39-18-24-6-49-16-37z"/>
                <path d="m358 88 33-18 48 13 23 20 38-6 49 20 25 31-23 17-31-13-18 29-28 7-16 34-31 1-18-26-30-7-13-39-25-16z"/>
                <path d="m420 219 31-18 39 11 16 31-12 52-30 47-26-21-10-45-21-27z"/>
                <path d="m552 244 34-16 45 12 20 29-22 27-43-7-27-20z"/>
              </g>
              <g fill="url(#swath)" stroke="#45d3e5" stroke-opacity=".86" stroke-width="1.2" transform="rotate(-24 380 190)">
                <path d="M290 56h22v34h-22zM314 56h22v34h-22zM338 56h22v34h-22zM362 56h22v34h-22zM386 56h22v34h-22zM410 56h22v34h-22zM434 56h22v34h-22zM458 56h22v34h-22z"/>
                <path d="M290 92h22v34h-22zM314 92h22v34h-22zM338 92h22v34h-22zM362 92h22v34h-22zM386 92h22v34h-22zM410 92h22v34h-22zM434 92h22v34h-22zM458 92h22v34h-22z"/>
                <path d="M290 128h22v34h-22zM314 128h22v34h-22zM338 128h22v34h-22zM362 128h22v34h-22zM386 128h22v34h-22zM410 128h22v34h-22zM434 128h22v34h-22zM458 128h22v34h-22z"/>
                <path d="M290 164h22v34h-22zM314 164h22v34h-22zM338 164h22v34h-22zM362 164h22v34h-22zM386 164h22v34h-22zM410 164h22v34h-22zM434 164h22v34h-22zM458 164h22v34h-22z"/>
              </g>
              <g fill="#55d8e9"><circle cx="373" cy="170" r="3"/><circle cx="396" cy="204" r="3"/><circle cx="419" cy="236" r="3"/></g>
              <text x="22" y="364" fill="#9dbbc9" font-size="11" font-family="monospace">GOME-2 · ORBIT 32260 · PIXEL FOOTPRINTS</text>
              <text x="608" y="364" fill="#9dbbc9" font-size="11" font-family="monospace">15,574 PIXELS</text>
            </svg>
          </div>
        <div class="preview-foot"><span><i class="key amber"></i> Band 3 radiance</span><span><i class="key outline"></i> Pixel bounds</span><span>LAT / LON <b>●</b></span></div>
        </div>
        <div class="hero-index">01 <span>/</span> DATA, MADE VISIBLE</div>
      </section>

      <section class="ticker" aria-label="Supported formats and views"><div class="ticker-inner">HDF5 <b>✳</b> NETCDF <b>✳</b> MULTIDIMENSIONAL ARRAYS <b>✳</b> SCAN PIXEL FOOTPRINTS <b>✳</b> HDF5 <b>✳</b> NETCDF <b>✳</b> MULTIDIMENSIONAL ARRAYS <b>✳</b> SCAN PIXEL FOOTPRINTS</div></section>

      <section id="capabilities" class="section wrap">
        <div class="section-intro"><p class="eyebrow">BUILT FOR EXPLORATION</p><h2>From file tree<br />to field of view.</h2><p class="section-note">Scientific data is more than a list of numbers. Keep structure, dimensions, and spatial context in view as you explore.</p></div>
        <div class="feature-list">{features.map((feature) => <article class="feature"><span class="feature-n">{feature.n}</span><div><h3>{feature.title}</h3><p>{feature.body}</p></div><span class="feature-arrow">↗</span></article>)}</div>
      </section>

      <section id="data" class="data-band">
        <div class="wrap data-content"><div><p class="eyebrow">REAL DATA, REAL FOOTPRINTS</p><h2>Scan lines you<br />can actually see.</h2><p>Explore a bundled GOME-2 Band 3 sample with 15,574 valid geolocated pixels and measured radiance across 64 spectral channels. Each pixel retains its center coordinates, four corners, and scan direction.</p><a class="button light" href="./guide/">Open the guide <span>→</span></a></div>
          <div class="data-card"><div class="card-label">IN THE EXAMPLE FILE</div><div class="data-row"><span>Instrument</span><b>GOME-2 / MetOp-B</b></div><div class="data-row"><span>Orbit</span><b>32260 · 2013-01-06</b></div><div class="data-row"><span>Variable</span><b>Band 3 radiance</b></div><div class="data-row"><span>Footprint corners</span><b>4 per pixel</b></div><div class="card-source">Source: GOME-2 Level 1B product</div></div>
        </div>
      </section>

      <section class="views wrap"><p class="eyebrow">ONE FILE, MANY ANGLES</p><div class="view-chips">{views.map((view, i) => <span class:list={["chip", i === 4 && "selected"]}>{view}<small>0{i+1}</small></span>)}</div></section>

      <section class="closing wrap"><img class="closing-icon" src="./h5jive.png" width="82" height="82" alt="" /><div><p class="eyebrow">OPEN THE PROJECT</p><h2>Start with a dataset.<br /><em>See where it leads.</em></h2></div><div class="closing-actions"><a class="button primary" href="./guide/">Read the guide <span>→</span></a><a class="text-link" href="https://github.com/vrtulka23/h5jive">Browse source <span>↗</span></a></div></section>
    </main>
    <footer class="footer wrap"><a class="brand" href="#top"><img class="brand-icon" src="./h5jive.png" width="32" height="32" alt="" /> H5Jive</a><span>Dig into your data.</span><span>© H5Jive contributors</span></footer>
  </body>
</html>

