---
import TopNav from '../../components/TopNav.astro';

import { featurePages } from '../../data/features';

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#081b2d" />
    <meta name="description" content="Explore H5Jive's file shortcuts, table editing, tutorial tips, and geographic coverage preview." />
    <link rel="icon" type="image/png" href="../h5jive-icon.png" />
    <link rel="stylesheet" href="../site.css" />
    <link rel="stylesheet" href="../layout.css" />
    <link rel="stylesheet" href="../features.css" />
    <script data-goatcounter="https://h5jive.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
    <title>Features — H5Jive</title>
  </head>
  <body>
    <header class="topbar wrap">
      <a class="brand" href="../" aria-label="H5Jive home"><img class="brand-icon" src="../h5jive.png" width="42" height="42" alt="" /> H5Jive</a>
      <TopNav root="../" current="features" />
    </header>

    <main class="features-page wrap">
      <section class="features-intro" aria-labelledby="features-title">
        <div><p class="eyebrow">H5JIVE / FEATURES</p><h1 id="features-title">Small details.<br /><em>Smoother exploring.</em></h1></div>
        <p>Alongside the main views, H5Jive has a few shortcuts that make everyday work with scientific files easier.</p>
      </section>

      <div class="feature-sections">
        {featurePages.map((feature, index) => (
          <section class={`feature-section${index % 2 === 1 ? ' feature-section--reverse' : ''}`} id={`feature-${index + 1}`} aria-labelledby={`feature-title-${index + 1}`}>
            <figure class="feature-section-media">
              <a href={`../${feature.image}`} aria-label={`Open full-size ${feature.title} screenshot`}>
                <img src={`../${feature.image}`} width={feature.imageWidth} height={feature.imageHeight} alt={feature.imageAlt} loading={index < 1 ? 'eager' : 'lazy'} decoding="async" />
              </a>
              <figcaption><span>H5JIVE <span class="caption-divider">/</span> {feature.title.toUpperCase()}</span><a href={`../${feature.image}`}>View full size <span aria-hidden="true">↗</span></a></figcaption>
            </figure>
            <div class="feature-section-copy">
              <p class="eyebrow">FEATURE 0{index + 1} / 06</p>
              <h2 id={`feature-title-${index + 1}`}>{feature.title}</h2>
              <p class="feature-section-body">{feature.body}</p>
              {feature.link && <a class="text-link" href={feature.link}>{feature.linkLabel} <span aria-hidden="true">↗</span></a>}
            </div>
          </section>
        ))}
      </div>
    </main>
    <footer class="footer wrap"><a class="brand" href="../"><img class="brand-icon" src="../h5jive.png" width="32" height="32" alt="" /> H5Jive</a><span>Dig into your data.</span><span>© H5Jive contributors</span></footer>
  </body>
</html>
