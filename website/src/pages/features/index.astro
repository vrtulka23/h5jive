---
import TopNav from '../../components/TopNav.astro';

const features = [
  {
    title: 'Drop a file into A or B.',
    body: 'Drag a local data file over the H5Jive window. Two targets appear: drop on the left to open it as File A, or on the right to open it as File B for comparison.',
    image: 'feature-drag-and-drop.png',
    imageWidth: 1158,
    imageHeight: 838,
    imageAlt: 'H5Jive window showing two drag and drop targets labeled Drop as File A and Drop as File B, with a local file hovering over the left target',
  },
  {
    title: 'Switch files from the tree.',
    body: 'Click the file name under File A or File B to open the file picker for that tab. Choose a different file without leaving the dataset tree.',
    image: 'feature-quick-file-select.png',
    imageWidth: 962,
    imageHeight: 620,
    imageAlt: 'File A tab in the dataset tree with its file name underlined and a tooltip explaining that clicking it opens the file picker for this tab',
    link: '../guide/getting-started.html',
    linkLabel: 'Opening files in H5Jive',
  },
  {
    title: 'Edit, review, then apply.',
    body: 'Click a numeric table cell to change it. Staged values stay highlighted while you inspect the table, and you can apply or discard the changes together.',
    image: 'feature-value-edit.png',
    imageWidth: 1314,
    imageHeight: 648,
    imageAlt: 'H5Jive data table with highlighted pending cell edits, an active cell editor, and Discard and Apply changes buttons below the table',
    link: '../guide/exploring-data.html',
    linkLabel: 'How table editing works',
  },
  {
    title: 'See the footprint first.',
    body: 'Before exporting a spatiotemporal subset, preview the selected products as sampled points on a world map and two opposite globe hemispheres.',
    image: 'feature-coverage-preview.png',
    imageWidth: 1178,
    imageHeight: 1196,
    imageAlt: 'Coverage preview popup showing sampled orange points over a world map and two globe hemispheres with geographic grids and muted coastlines',
    link: '../plugins/#spatiotemporal-subset',
    linkLabel: 'Explore the subset plugin',
  },
  {
    title: 'Learn as you explore.',
    body: 'Tutorial tips explain interactive controls on hover. Turn them off from Help when you know your way around.',
    image: 'feature-tutorial-help.png',
    imageWidth: 1108,
    imageHeight: 372,
    imageAlt: 'Help menu with Tutorial tips checked and a tooltip explaining the setting',
    link: '../guide/settings-and-formats.html',
    linkLabel: 'Tutorial tip setting',
  },
  {
    title: 'Keep an eye on resources.',
    body: 'The top bar shows process memory, UI time, and the selected dataset’s raw size while you work.',
    image: 'feature-process-stats.png',
    imageWidth: 1086,
    imageHeight: 344,
    imageAlt: 'H5Jive status bar showing raw data size, RAM usage, UI time, and display backend',
    link: '../guide/exploring-data.html',
    linkLabel: 'Exploring data guide',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#081b2d" />
    <meta name="description" content="Explore H5Jive's file shortcuts, table editing, tutorial tips, and geographic coverage preview." />
    <link rel="icon" type="image/png" href="../h5jive-icon.png" />
    <link rel="stylesheet" href="../site.css" />
    <link rel="stylesheet" href="../layout.css" />
    <link rel="stylesheet" href="../features.css" />
    <script data-goatcounter="https://h5jive.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
    <title>Features — H5Jive</title>
  </head>
  <body>
    <header class="topbar wrap">
      <a class="brand" href="../" aria-label="H5Jive home"><img class="brand-icon" src="../h5jive.png" width="42" height="42" alt="" /> H5Jive</a>
      <TopNav root="../" current="features" />
    </header>

    <main class="features-page wrap">
      <section class="features-intro" aria-labelledby="features-title">
        <div><p class="eyebrow">H5JIVE / FEATURES</p><h1 id="features-title">Small details.<br /><em>Smoother exploring.</em></h1></div>
        <p>Alongside the main views, H5Jive has a few shortcuts that make everyday work with scientific files easier.</p>
      </section>

      <div class="feature-sections">
        {features.map((feature, index) => (
          <section class={`feature-section${index % 2 === 1 ? ' feature-section--reverse' : ''}`} id={`feature-${index + 1}`} aria-labelledby={`feature-title-${index + 1}`}>
            <figure class="feature-section-media">
              <a href={`../${feature.image}`} aria-label={`Open full-size ${feature.title} screenshot`}>
                <img src={`../${feature.image}`} width={feature.imageWidth} height={feature.imageHeight} alt={feature.imageAlt} loading={index < 1 ? 'eager' : 'lazy'} decoding="async" />
              </a>
              <figcaption><span>H5JIVE <span class="caption-divider">/</span> {feature.title.toUpperCase()}</span><a href={`../${feature.image}`}>View full size <span aria-hidden="true">↗</span></a></figcaption>
            </figure>
            <div class="feature-section-copy">
              <p class="eyebrow">FEATURE 0{index + 1} / 06</p>
              <h2 id={`feature-title-${index + 1}`}>{feature.title}</h2>
              <p class="feature-section-body">{feature.body}</p>
              {feature.link && <a class="text-link" href={feature.link}>{feature.linkLabel} <span aria-hidden="true">↗</span></a>}
            </div>
          </section>
        ))}
      </div>
    </main>
    <footer class="footer wrap"><a class="brand" href="../"><img class="brand-icon" src="../h5jive.png" width="32" height="32" alt="" /> H5Jive</a><span>Dig into your data.</span><span>© H5Jive contributors</span></footer>
  </body>
</html>
