---
import { viewPages } from '../../data/views';
import TopNav from '../../components/TopNav.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#081b2d" />
    <meta name="description" content="Explore H5Jive's data table, profiles, slices, 3D projections, world map, and globe views." />
    <link rel="icon" type="image/png" href="../h5jive-icon.png" />
    <link rel="stylesheet" href="../site.css" />
    <link rel="stylesheet" href="../layout.css" />
    <link rel="stylesheet" href="../views.css" />
    <script data-goatcounter="https://h5jive.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
    <title>Views — H5Jive</title>
  </head>
  <body>
    <header class="topbar wrap">
      <a class="brand" href="../" aria-label="H5Jive home"><img class="brand-icon" src="../h5jive.png" width="42" height="42" alt="" /> H5Jive</a>
      <TopNav root="../" current="views" />
    </header>

    <main class="views-page wrap">
      <section class="views-intro" aria-labelledby="views-title">
        <div><p class="eyebrow">H5JIVE / VIEWS</p><h1 id="views-title">One dataset.<br /><em>Many ways to see it.</em></h1></div>
        <p>Move between source values, profiles, slices, 3D projections, and geographic views. Each view keeps the selected dataset in context while showing a different part of its shape or location.</p>
      </section>

      <div class="views-sections">
        {viewPages.map((view, index) => (
          <section class={`view-section${index % 2 === 1 ? ' view-section--reverse' : ''}`} id={view.slug} aria-labelledby={`view-title-${view.slug}`}>
            <figure class="view-section-media">
              <a href={`../${view.image}`} aria-label={`Open full-size ${view.title} screenshot`}>
                <img src={`../${view.image}`} width={view.imageWidth} height={view.imageHeight} alt={view.alt} loading={index < 1 ? 'eager' : 'lazy'} decoding="async" />
              </a>
              <figcaption><span>H5JIVE <span class="caption-divider">/</span> {view.title.toUpperCase()}</span><span>{view.caption}</span></figcaption>
            </figure>
            <div class="view-section-copy">
              <p class="eyebrow">VIEW 0{index + 1} / 06 · {view.kicker.toUpperCase()}</p>
              <h2 id={`view-title-${view.slug}`}>{view.title}<span class="view-title-dot">.</span></h2>
              <p class="view-section-summary">{view.summary}</p>
              <ul class="view-section-highlights">
                {view.points.map(([title, body]) => (
                  <li><strong>{title}</strong><span>{body}</span></li>
                ))}
              </ul>
              <a class="text-link" href="../guide/exploring-data.html">Explore controls and examples <span aria-hidden="true">↗</span></a>
            </div>
          </section>
        ))}
      </div>

      <div class="views-guide"><p>Want the full list of controls and examples?</p><a class="button primary" href="../guide/exploring-data.html">Read the exploring data guide <span>→</span></a></div>
      <p class="sample-credit">Screenshots show modified EUMETSAT Metop-B GOME-2 Level 1B data (2013). © EUMETSAT 2013. <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. Map backgrounds: <a href="https://www.naturalearthdata.com/about/terms-of-use/">Natural Earth</a>.</p>
    </main>
    <footer class="footer wrap"><a class="brand" href="../"><img class="brand-icon" src="../h5jive.png" width="32" height="32" alt="" /> H5Jive</a><span>Dig into your data.</span><span>© H5Jive contributors</span></footer>
  </body>
</html>
